# ─────────────────────────────────────────────────────────────────────────────
# مفتاح الـ API — يُقرأ من هنا فقط (لا يوجد إدخال للمفتاح من الواجهة)
# The API key is read ONLY from this file (there is no key field in the UI).
# ─────────────────────────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=

# ─────────────────────────────────────────────────────────────────────────────
# حماية الدخول — ضروري قبل رفع الأداة على هوست عام
# Access protection — REQUIRED before exposing the app on a public host.
# With APP_PASSWORD set, the browser asks for username/password (serve over HTTPS).
# Leave empty only when running locally.
# ─────────────────────────────────────────────────────────────────────────────
APP_USERNAME=admin
APP_PASSWORD=

# ─────────────────────────────────────────────────────────────────────────────
# الموديل الافتراضي (الخيار "Default model from .env" في الواجهة)
# الأسعار بالدولار لكل مليون توكن (إدخال / إخراج) — سبتمبر 2026:
#
#   claude-haiku-4-5-20251001  → الأوفر والأسرع            $1 / $5
#                                 مناسب للتجارب والتحليلات الكبيرة الكثيرة، دقة أقل في العربي المعقد
#   claude-sonnet-5            → متوازن (موصى به)          $2 / $10
#                                 أفضل نسبة جودة/سعر لاستخراج الكيانات والعناقيد
#   claude-sonnet-4-6          → جيل سابق                  $3 / $15
#                                 أغلى من Sonnet 5 وأقدم — لا ننصح به إلا للتوافق
#   claude-opus-5-5            → أعلى دقة للتحليل العميق   $4 / $20
#                                 للمقالات الطويلة والمنافسة الشرسة
#   claude-fable-5-1           → الأقوى والأغلى            $10 / $50
#                                 للحالات الصعبة جداً فقط (احتفاظ بالبيانات 30 يوماً)
#
# Retired IDs (claude-3-*, claude-3-7-*, ...) are ignored and fall back to claude-sonnet-5.
# ─────────────────────────────────────────────────────────────────────────────
CLAUDE_DEFAULT_MODEL=claude-sonnet-5
# Optional per-task overrides (empty = CLAUDE_DEFAULT_MODEL)
CLAUDE_EXTRACTION_MODEL=
CLAUDE_BRIEF_MODEL=
# ─────────────────────────────────────────────────────────────────────────────
# تجارب مجانية (اختياري): مفتاح Google AI Studio المجاني يظهر كخيار "Gemini" في القائمة.
# Free testing (optional): a free Google AI Studio key adds a "Gemini" option to the model list.
# Free tier: daily limits, lower accuracy than Claude, and Google may use free-tier data to improve its models.
# Set GEMINI_DEFAULT_MODEL to a current Flash model name shown in AI Studio.
# ─────────────────────────────────────────────────────────────────────────────
GEMINI_API_KEY=
GEMINI_DEFAULT_MODEL=gemini-3.6-flash

# Re-running the same page with the same settings reuses the saved AI answer for free (30 days).
ENABLE_CACHE=true

# Accuracy: precise = extraction + completeness pass + independent review (≈ +50% cost, recommended)
#           standard = single extraction pass (cheapest)
ACCURACY_MODE=precise
# Fast model used by the review pass (Claude engines only)
ENTITY_REVIEW_MODEL=claude-haiku-4-5-20251001
# Deterministic JSON extraction (0.0 - 0.1 recommended)
AI_TEMPERATURE=0.0
CLAUDE_EXTRACTION_MAX_TOKENS=8192
# Characters of each source sent to the AI (~30-50k tokens for Arabic)
AI_MAX_SOURCE_CHARS=120000
MISTRAL_MAX_OUTPUT_TOKENS=4096

MAX_CHARS=200000
MAX_COMPETITORS=30
NARA_CHUNK_CHAR_LIMIT=9000
SERP_CHUNK_CHAR_LIMIT=18000
SERP_MAP_MAX_TOKENS=2400
SERP_PROFILE_BATCH_SIZE=8
SERP_PROFILE_BATCH_WORKERS=2
SERP_PROFILE_MAX_TOKENS=4200
SERP_PROFILE_BATCH_MAX_CHARS=76000
SERP_LOCAL_PARAGRAPH_SAMPLES=90
SERP_AI_PARAGRAPH_SAMPLES=34
SERP_PROFILE_EVIDENCE_CHAR_BUDGET=12000
SERP_PER_SOURCE_COVERAGE_ITEMS=14
SERP_GLOBAL_TOPIC_LIMIT=180
SERP_GLOBAL_ENTITY_LIMIT=220
SERP_GLOBAL_QUESTION_LIMIT=120
SERP_AUDIT_MAX_TOKENS=4200
SERP_FINAL_MAX_TOKENS=8000
SERP_MIN_TOPIC_COVERAGE=0.30
SERP_MIN_SOURCE_COVERAGE=0.80
MAX_CONTENT_LENGTH_MB=15
MAX_FILE_BYTES=15728640
MAX_URL_RESPONSE_BYTES=15728640
MAX_REDIRECTS=4
ALLOWED_URL_PORTS=80,443
# Optional third-party reader for weak pages (never used for blocked pages). Sends the URL to r.jina.ai.
ENABLE_JINA_FALLBACK=true
# Chromium render for JS/SPA pages (run once: python -m playwright install chromium)
ENABLE_BROWSER_FALLBACK=true
ENABLE_URL_MEMORY_CACHE=true
URL_MEMORY_CACHE_TTL_SECONDS=600
URL_MEMORY_CACHE_MAX_CHARS=12000000
BROWSER_RENDER_TIMEOUT=15
BROWSER_NETWORK_IDLE_TIMEOUT=5
BROWSER_MAX_CONCURRENT=2
MIN_ACCEPTABLE_EXTRACTED_CHARS=1200
STRONG_EXTRACTED_CHARS=4500
STRONG_EXTRACTED_HEADINGS=3

MAX_FETCH_WORKERS=8
MAX_SOURCE_WORKERS=4
MAX_CHUNK_WORKERS=2

NARA_CONNECT_TIMEOUT=10
NARA_REQUEST_TIMEOUT=180
NARA_MAX_RETRIES=3
NARA_SLOW_MAX_RETRIES=2
NARA_RETRY_BACKOFF_BASE=1.5
NARA_429_MAX_RETRIES=4
NARA_429_MAX_BACKOFF_SECONDS=24
NARA_MAX_CONCURRENT_REQUESTS=2
NARA_MIN_REQUEST_INTERVAL=0.75

CACHE_DIR=.cache
CACHE_TTL_SECONDS=2592000
TEMP_FILE_TTL_SECONDS=7200

PORT=5000
FLASK_DEBUG=false
STATIC_DIR=static
CORS_ALLOWED_ORIGINS=
LOG_LEVEL=INFO

# Rich HTML content brief
CONTENT_BRIEF_MAX_TOKENS=7000

# Production hardening / observability
APP_NAME=Semantic SEO Tool
APP_VERSION=2.0.0
TRUST_PROXY_HEADERS=false
ENFORCE_SAME_ORIGIN=true
ENABLE_HSTS=true
HSTS_MAX_AGE_SECONDS=31536000
MAX_ACTIVE_JOBS=20
# Use Redis in multi-instance production, e.g. redis://host:6379/0
RATELIMIT_STORAGE_URI=memory://
DEFAULT_RATE_LIMITS=300 per day,60 per hour
FILTER_FOREIGN_LANGUAGE_BLOCKS=true
MIN_GAP_ENTITY_EVIDENCE=0.35
MIN_GAP_SOURCES=2
MIN_SUPPORTED_EVIDENCE=0.6
MAX_SERP_FILES=20
